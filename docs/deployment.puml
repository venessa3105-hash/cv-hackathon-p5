@startuml
title P5 - Training & Deployment Flow
left to right direction
skinparam componentStyle rectangle
skinparam defaultFontName Arial

database "Stanford Cars dataset\n(Kaggle mirror of official)\n8,144 train / 8,041 test\n196 classes" as DS

package "Kaggle GPU notebooks" {
  [train_classifier.py\nConvNeXt-Tiny fine-tune\n94.66% Top-1 / 99.33% Top-5] as C
  [train_detector.py\nYOLO11n fine-tune\nmAP@0.5 0.995, mAP@0.5:0.95 0.941] as D
  [train_classical.py\nHOG+LBP+colour+geometric -> SVM\n16.29% Top-1] as K
  [eval_hybrid_optimize.py\npipeline ablation, robustness,\nthresholds, FP16 / INT8 ONNX] as E
}

cloud "Hugging Face Hub\nmodel repo\n(vene-05/p5-convnext-cars)" as HF
folder "GitHub repo\n(code + docs + eval)" as GH
node "App host\nGradio app.py" as APP
actor "User / Judge" as U

DS --> C
DS --> D
DS --> K
DS --> E
C --> HF : best_model.pth\nconfig.json
D --> HF : det_best.pt
K --> HF : classical_model.joblib
E --> HF : metrics JSON\ncars_int8.onnx
HF --> APP : downloads weights\nat startup
GH --> APP : app code
U --> APP : uploads car photo
@enduml
